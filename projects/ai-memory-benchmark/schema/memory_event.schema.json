{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanocubit.local/lab/ai-memory-benchmark/schema/memory_event.schema.json",
  "title": "AI Memory Benchmark v0.1 MemoryEvent",
  "description": "Canonical immutable event envelope. JSON Schema validates shape; cross-event and temporal semantics are validated separately.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "world_id",
    "sequence",
    "timestamp",
    "observed_at",
    "valid_from",
    "valid_to",
    "agent_id",
    "entity_id",
    "entity_type",
    "kind",
    "payload",
    "provenance",
    "confidence",
    "previous_event_ids",
    "relations",
    "embedding",
    "extensions"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$", "minLength": 5 },
    "world_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "$ref": "#/$defs/utcTimestamp" },
    "observed_at": { "oneOf": [{ "$ref": "#/$defs/utcTimestamp" }, { "type": "null" }] },
    "valid_from": { "$ref": "#/$defs/utcTimestamp" },
    "valid_to": { "oneOf": [{ "$ref": "#/$defs/utcTimestamp" }, { "type": "null" }] },
    "agent_id": { "type": "string", "pattern": "^agent_[A-Za-z0-9_-]+$", "minLength": 7 },
    "entity_id": { "type": "string", "minLength": 1, "not": { "pattern": "^evt_" } },
    "entity_type": { "enum": ["person", "organization", "device", "task", "project", "document", "location", "system", "environment", "abstract_concept", "agent"] },
    "kind": { "enum": ["observation", "evidence", "claim", "decision", "action", "result", "revision"] },
    "status": { "description": "Optional denormalized cache only; never authoritative benchmark state.", "enum": ["active", "confirmed", "contested", "expired", "superseded", "invalidated"] },
    "payload": { "$ref": "#/$defs/payload" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "previous_event_ids": { "type": "array", "items": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" }, "uniqueItems": true, "default": [] },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" }, "default": [] },
    "embedding": { "$ref": "#/$defs/embedding" },
    "metadata": { "description": "Optional non-semantic annotations.", "type": "object", "additionalProperties": true },
    "extensions": {
      "description": "Opaque vendor/runtime extension namespaces; keys SHOULD be reverse-DNS namespaces.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$" },
      "additionalProperties": { "type": "object", "additionalProperties": true },
      "default": {}
    }
  },
  "allOf": [{
    "if": { "properties": { "kind": { "const": "revision" } }, "required": ["kind"] },
    "then": {
      "properties": {
        "relations": {
          "contains": { "type": "object", "properties": { "type": { "enum": ["revises", "supersedes", "invalidates", "contradicts"] } }, "required": ["type"] },
          "minContains": 1
        }
      }
    }
  }],
  "$defs": {
    "utcTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "value", "text", "attributes"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "value": {},
        "text": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "source_uri", "source_timezone", "generator_rule", "source_event_ids", "attributes"],
      "properties": {
        "source_type": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_uri": { "type": ["string", "null"] },
        "source_timezone": { "type": "string", "minLength": 1 },
        "generator_rule": { "type": ["string", "null"] },
        "source_event_ids": { "type": "array", "items": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" }, "uniqueItems": true, "default": [] },
        "attributes": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id", "target_type"],
      "properties": {
        "type": { "enum": ["about", "observed_by", "derived_from", "extracted_from", "supports", "corroborates", "weakens", "contradicts", "revises", "supersedes", "invalidates", "based_on", "caused", "triggered", "executed_from", "result_of", "affects", "depends_on", "mentions", "same_as"] },
        "target_id": { "type": "string", "minLength": 1 },
        "target_type": { "enum": ["event", "entity"] },
        "attributes": { "type": "object", "additionalProperties": true, "default": {} }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "dimensions", "vector"],
      "properties": {
        "model_id": { "const": "deterministic-hash-384-v1" },
        "dimensions": { "const": 384 },
        "vector": { "type": "array", "minItems": 384, "maxItems": 384, "items": { "type": "number" } }
      }
    }
  }
}
