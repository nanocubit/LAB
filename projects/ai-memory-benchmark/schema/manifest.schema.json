{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-memory-benchmark.dev/schema/manifest.schema.json",
  "title": "DatasetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "version", "events_file", "queries_file", "event_count", "query_count"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "events_file": {"type": "string", "minLength": 1},
    "queries_file": {"type": "string", "minLength": 1},
    "golden_file": {"type": "string", "minLength": 1},
    "event_count": {"type": "integer", "minimum": 0},
    "query_count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
