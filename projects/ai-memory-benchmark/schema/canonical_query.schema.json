{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-memory-benchmark.dev/schema/canonical_query.schema.json",
  "title": "CanonicalQuery",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "subject_id", "as_of", "query", "expected_memory_ids"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "query": {"type": "string", "minLength": 1},
    "expected_memory_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
